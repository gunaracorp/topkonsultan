// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  refCode   String   @unique
  name      String
  email     String
  company   String?
  budget    String?
  role      String?
  type      String   @default("general")
  challenge String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Portal Klien — status penanganan kasus per tiket (dibootstrap dari
/// ContactMessage saat klien pertama kali login, lalu dimutakhirkan tim TOP).
model ClientCase {
  id        String   @id @default(cuid())
  refCode   String   @unique
  email     String
  name      String
  company   String?
  service   String?
  stage     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Transaksi Penuh — invoice online per kasus (v2.4.0.0.0).
/// Diterbitkan officer via /api/invoice (aksi `issue`, kunci OFFICER_KEY);
/// klien melihat via tautan /invoice?no=…&k=TOKEN atau dasbor portal (aksi `mine`).
/// `amount` = nominal dalam `currency`; `amountIdr` = ekuivalen Rupiah saat
/// terbit (QRIS selalu setor Rupiah).
model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  ticket      String
  clientName  String
  clientEmail String
  service     String
  currency    String   @default("IDR")
  amount      Int
  amountIdr   Int
  status      String   @default("unpaid") // unpaid | paid | void
  note        String?
  viewToken   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Portal v2 — berkas yang diunggah klien untuk kasusnya (v2.5.1.0.0).
/// Diunggah via /api/portal (aksi `upload`, sesi token HMAC); diverifikasi
/// officer (aksi `doc-verify` / `doc-reject`, kunci OFFICER_KEY).
/// `name` = jenis dokumen (checklist DOCS), `filename` = nama file asli,
/// `data` = konten base64 (maks 4 MB per berkas).
model CaseDocument {
  id        String   @id @default(cuid())
  ticket    String
  name      String
  filename  String
  mime      String
  size      Int
  data      String
  status    String   @default("pending") // pending | verified | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Portal v2 — log notifikasi email per kasus (v2.5.1.0.0).
/// Setiap peristiwa kasus (tiket terbit, tahap berubah, dokumen, invoice)
/// menghasilkan satu baris; `status` mencatat nasib pengiriman:
/// queued (mode antrean tanpa kredensial pengirim) | sent | failed.
model Notification {
  id        String   @id @default(cuid())
  ticket    String
  toEmail   String
  kind      String // case-created | stage | doc-received | doc-verified | doc-rejected | invoice-issued | invoice-paid
  subject   String
  bodyText  String
  bodyHtml  String
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now())
}
